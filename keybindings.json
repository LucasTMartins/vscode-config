// Coloque as suas associações de teclas neste arquivo para substituir os padrões
[
  //---------- EDIÇÃO NO EDITOR
  // Salvar aquivo atual
  {
    "key": "alt+w",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  // Comentar linha atual
  {
    "key": "alt+;",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  // Comentar linha atual (WINDOWS)
  {
    "key": "alt+oem_2",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  //---------- NAVEGAÇÃO E VISIBILIDADE
  // Alterar foco para o explorador de arquivos
  {
    "key": "alt+shift+e",
    "command": "workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled"
  },
  // Fechar o explorador de arquivos
  {
    "key": "space e",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "filesExplorerFocus && !inputFocus"
  },
  // Maximizar painel inferior
  {
    "key": "shift+alt+s",
    "command": "workbench.action.toggleMaximizedPanel"
  },
  // Ir para linha específica
  {
    "key": "alt+o",
    "command": "workbench.action.gotoLine"
  },
  // Abrir novo terminal
  {
    "key": "shift+alt+w",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },
  // Alterar visibilidade da barra de atividade
  {
    "key": "alt+q",
    "command": "workbench.action.toggleActivityBarVisibility"
  },
  // Alterar visibilidade do painel inferior
  {
    "key": "alt+s",
    "command": "workbench.action.togglePanel"
  },
  // Alterar visibilidade da barra lateral
  {
    "key": "alt+e",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  //---------- NO EXPLORADOR DE ARQUIVOS
  // Criar novo arquivo
  {
    "key": "n",
    "command": "explorer.newFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  // Criar nova pasta
  {
    "key": "f",
    "command": "explorer.newFolder",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  // Renomear arquivo
  {
    "key": "r",
    "command": "renameFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  // Recortar arquivo
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  // Copiar arquivo
  {
    "key": "y",
    "command": "filesExplorer.copy",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !inputFocus"
  },
  // Colar arquivo
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceReadonly && !inputFocus"
  },
  // Deletar arquivo
  {
    "key": "d",
    "command": "deleteFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceReadonly && !inputFocus"
  },
  // Copiar caminho absoluto do arquivo
  {
    "key": "c",
    "command": "copyFilePath",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceReadonly && !inputFocus"
  },
  // Copiar caminho relativo do arquivo
  {
    "key": "shift+c",
    "command": "copyRelativeFilePath",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceReadonly && !inputFocus"
  },
  //----- REMOVER ATALHOS PADRÕES NÃO UTILIZADOS
  {
    "key": "alt+w",
    "command": "-toggleSearchEditorWholeWord",
    "when": "inSearchEditor && searchInputBoxFocus"
  },
  {
    "key": "alt+w",
    "command": "-workbench.action.terminal.toggleFindWholeWord",
    "when": "terminalFindVisible && terminalHasBeenCreated || terminalFindVisible && terminalProcessSupported"
  },
  {
    "key": "alt+w",
    "command": "-toggleFindWholeWord",
    "when": "editorFocus"
  },
  {
    "key": "alt+w",
    "command": "-toggleSearchWholeWord",
    "when": "searchViewletFocus"
  },
]